{
  "name": "pacific-speed-overdrive",
  "version": "1.0.0",
  "description": "PACIFIC SPEED: OVERDRIVE - Asymmetric Co-op Arcade / Survival Runner (WebSockets + HTML5 Canvas + Web Audio API)",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:site": "npm --prefix site run build",
    "dev:site": "npm --prefix site run dev",
    "build": "npm run build:site && npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "firebase": "^13.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

# ========================================================
# PACIFIC SPEED: OVERDRIVE - Environment Configuration
# ========================================================

# --- PostgreSQL Database ---
# (Compatible con variables individuales o DATABASE_URL)
DB_SERVER=metro.proxy.rlwy.net
DB_PORT=27145
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=db_evento

# O si utilizas la cadena de conexión completa:
# DATABASE_URL=postgresql://postgres:password@metro.proxy.rlwy.net:27145/db_evento

# --- Master Admin Portal Key (/admin) ---
ADMIN_SECRET_KEY=admin_pacific_overdrive_2026--

# --- Payphone Gateway Configuration ---
# Token de Desarrollador / Merchant de Payphone (Bearer Token)
PAYPHONE_TOKEN=tu_token_de_payphone_aqui
# ID de Aplicación de Payphone (Client ID / App ID)
PAYPHONE_CLIENT_ID=tu_client_id_payphone
# Llave Secreta para verificar firmas HMAC de Webhooks
PAYPHONE_SECRET_KEY=tu_secret_key_payphone
# ID de Sucursal / Tienda Payphone (opcional)
PAYPHONE_STORE_ID=
# Entorno: production o sandbox (por defecto: production)
PAYPHONE_ENV=production

# --- Server Port ---
PORT=3000

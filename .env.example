# ========================================================
# PACIFIC SPEED: OVERDRIVE - Environment Configuration Template
# ========================================================

# --- PostgreSQL Database ---
# Compatible con variables individuales o DATABASE_URL
DB_SERVER=tu_host_postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=db_evento

# O si utilizas la cadena de conexión completa:
# DATABASE_URL=postgresql://postgres:password@host:5432/db_evento

# --- Master Admin Portal Key (/admin) ---
# Obligatoria en producción (mín. 12 caracteres). Genera una propia; nunca la publiques.
ADMIN_SECRET_KEY=cambia_esta_clave_admin

# Secreto aleatorio SOLO para firmar tokens de sesión admin (mín. 32 caracteres, distinto de ADMIN_SECRET_KEY).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=genera_un_secreto_aleatorio_de_al_menos_32_caracteres

# Orígenes extra permitidos para WebSocket (separados por coma). Por defecto solo el propio host.
# ALLOWED_ORIGINS=https://tu-dominio.com

# URL pública para construir responseUrl/cancellationUrl de Payphone (recomendado en producción)
# PUBLIC_BASE_URL=https://tu-app.up.railway.app

# --- Server Port ---
PORT=3000

# --- Payphone Gateway Configuration ---
# Token de Desarrollador / Merchant de Payphone (Bearer Token, obligatorio en producción)
PAYPHONE_TOKEN=tu_token_de_payphone_aqui

# ID de Aplicación de Payphone (Client ID / App ID)
PAYPHONE_CLIENT_ID=tu_client_id_payphone

# Llave Secreta para verificar firmas HMAC de Webhooks (obligatoria en producción)
PAYPHONE_SECRET_KEY=tu_secret_key_payphone

# ID de Sucursal / Tienda Payphone (opcional, solo si tienes múltiples tiendas)
PAYPHONE_STORE_ID=

# Ambiente de Payphone (sandbox o production)
PAYPHONE_ENV=sandbox
